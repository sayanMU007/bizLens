# Copy to .env (never commit .env). Read by docker compose and by the Django backend only.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_DB=bizlens
POSTGRES_USER=bizlens
POSTGRES_PASSWORD=bizlens_dev_password
POSTGRES_HOST=localhost   # compose overrides this to "db" for the backend container
POSTGRES_PORT=5432

# --- LLM (backend only) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Datasets ---
MAX_UPLOAD_MB=25
MAX_ROWS=500000
MAX_INVALID_ROW_FRACTION=0.05
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_QUERY_TIMEOUT_SECONDS=10
